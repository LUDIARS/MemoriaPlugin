{
  "name": "memoria-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Memoria ユーザーアプリ用プラグインフレームワーク。 Memoria 本体に submodule として取り込まれ in-process マウントされる。",
  "scripts": {
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --lib ES2022",
    "package": "tsx scripts/package.ts",
    "catalog": "tsx scripts/catalog.ts",
    "test": "tsx --test scripts/packages.test.ts scripts/lifecycle.test.ts scripts/catalog.test.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "semver": "7.8.5",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
